rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function untuk cek autentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'albianavl.co@gmail.com' ||
        request.auth.token.email.lower() == 'alfreelnc.desigh@gmail.com'
      );
    }

    // Koleksi portofolio proyek: bebas dibaca semua pengunjung, bisa diupdate admin
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi artikel & blog: bebas dibaca semua pengunjung
    match /blogPosts/{blogId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi riwayat pengalaman & sertifikasi
    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if true;
    }

    // Pengaturan website (global & CV)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Statistik & jumlah kunjungan web
    match /stats/{docId} {
      allow read, write: if true;
    }

    // Pesanan layanan desain dari pengunjung
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Pesan kontak & formulir diskusi dari pengunjung
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Pengguna admin & hak akses
    match /adminUsers/{userId} {
      allow read, write: if true;
    }
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Folder arsip
    match /archiveFolders/{folderId} {
      allow read, write: if true;
    }

    // Fallback umum agar tidak ada fitur atau pengunjung yang terblokir secara tidak sengaja
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
