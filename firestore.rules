rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi untuk mengecek apakah user yang login adalah admin utama atau admin yang diizinkan
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'alfreelnc.desigh@gmail.com' ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.status == 'allowed')
      );
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    match /adminUsers/{emailId} {
      // Izinkan pengguna membaca dokumen miliknya sendiri (untuk cek status login)
      allow get: if request.auth != null && request.auth.token.email == emailId;
      // Izinkan admin untuk membaca dan mengubah daftar pengguna admin
      allow read, write: if isAdmin();
    }
    
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /messages/{messageId} {
      allow read: if isAdmin();
      allow write: if true; // Publik bisa kirim pesan
      allow delete: if isAdmin();
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }
    match /stats/{statId} {
      allow read: if true;
      allow write: if true; // Publik bisa increment views (update)
    }
    
    match /archiveFolders/{folderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /experiences/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
