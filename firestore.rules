rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'albianavl.co@gmail.com' ||
        request.auth.token.email.lower() == 'alfreelnc.desigh@gmail.com'
      );
    }

    function isRegisteredAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email.lower())).data.status == 'allowed'
      );
    }
    
    function isAdmin() {
      return isMasterAdmin() || isRegisteredAdmin();
    }

    // Public portfolio projects: anyone can read, admin or app write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Public blog posts
    match /blogPosts/{blogId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Public work experiences
    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Public site settings (global & cv)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Stats collection: page view tracking
    match /stats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer orders: public submission allowed
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || true;
    }

    // Contact messages: public submission allowed
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || true;
    }

    // Admin users collection
    match /adminUsers/{userId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
    match /admin_users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Archive folders collection
    match /archiveFolders/{folderId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Default allow for backward compatibility
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
