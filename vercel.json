{
  "version": 2,
  "functions": {
    "api/og-html.ts": {
      "includeFiles": "{dist/_app.html,firebase-applet-config.json}"
    },
    "api/og-image.ts": {
      "includeFiles": "{public/images/**,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/og/hero/:version",
      "destination": "/api/og-image?type=hero&v=:version"
    },
    {
      "source": "/og/project/:id/:version",
      "destination": "/api/og-image?project=:id&v=:version"
    },
    {
      "source": "/project/:id",
      "destination": "/api/og-html?project=:id"
    },
    {
      "source": "/",
      "destination": "/api/og-html"
    },
    {
      "source": "/((?!api/|og/|assets/|images/|uploads/|src/|index\\.html$|_app\\.html$|favicon|sw\\.js$|manifest\\.json$|robots\\.txt$|sitemap\\.xml$|pwa-|logo|apple-touch-icon|google).*)",
      "destination": "/api/og-html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(pwa-.*|logo-text-.*|apple-touch-icon\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
