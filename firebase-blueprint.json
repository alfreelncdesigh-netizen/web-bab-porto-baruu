{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project entry.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "category", "image", "description"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website and CV settings.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 200 },
        "cvRole": { "type": "string", "maxLength": 200 },
        "cvPdfFile": { "type": "string", "maxLength": 2000 },
        "cvSections": { "type": "array", "description": "List of CV sections with text and image arrays." },
        "contactEmail": { "type": "string", "maxLength": 200 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "contactLocation": { "type": "string", "maxLength": 200 }
      }
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "A blog article entry.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "excerpt": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 20000 },
        "category": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "content"]
    },
    "BlogComment": {
      "title": "BlogComment",
      "description": "Visitor comment submitted on a specific blog article.",
      "type": "object",
      "properties": {
        "blogId": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "message"]
    },
    "Experience": {
      "title": "Experience",
      "description": "A work experience and achievement record.",
      "type": "object",
      "properties": {
        "header": { "type": "string", "maxLength": 200 },
        "subtheme": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "images": { "type": "array", "description": "Array of image URLs for documentation and certificates." },
        "image": { "type": "string", "maxLength": 1000 },
        "isCollaboration": { "type": "boolean" },
        "collaborationPartner": { "type": "string", "maxLength": 200 },
        "collaborationLogo": { "type": "string", "maxLength": 1000 },
        "collaborationText": { "type": "string", "maxLength": 200 }
      },
      "required": ["header"]
    },
    "StatsViews": {
      "title": "StatsViews",
      "description": "Aggregate page view counter.",
      "type": "object",
      "properties": {
        "count": { "type": "number" }
      },
      "required": ["count"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order or inquiry submission.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 200 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "itemTitle": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["customerName", "customerEmail"]
    },
    "Message": {
      "title": "Message",
      "description": "Customer contact form message.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "email", "message"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator user.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["email"]
    },
    "ArchiveFolder": {
      "title": "ArchiveFolder",
      "description": "Folder container for archived portfolio works and articles.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 }
      },
      "required": ["name"]
    },
    "UploadedMedia": {
      "title": "UploadedMedia",
      "description": "Stores uploaded media files with backup dataUrl and metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "filename": { "type": "string" },
        "size": { "type": "number" },
        "dataUrl": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "url"]
    }
  },
  "firestore": {
    "projects": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Stores portfolio projects."
    },
    "settings": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Stores global site settings and CV data."
    },
    "blogPosts": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Stores blog articles."
    },
    "blogPosts/{blogId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/BlogComment" },
      "description": "Stores comments submitted by visitors for each blog article."
    },
    "experiences": {
      "schema": { "$ref": "#/entities/Experience" },
      "description": "Stores professional experiences."
    },
    "stats/views": {
      "schema": { "$ref": "#/entities/StatsViews" },
      "description": "Stores aggregate public view count."
    },
    "orders": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores customer store orders."
    },
    "messages": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Stores contact messages."
    },
    "admin_users": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Stores authorized admin user profiles."
    },
    "archiveFolders": {
      "schema": { "$ref": "#/entities/ArchiveFolder" },
      "description": "Stores archive folders."
    },
    "uploadedMedia": {
      "schema": { "$ref": "#/entities/UploadedMedia" },
      "description": "Stores permanently preserved uploaded media files and dataUrls."
    }
  }
}
